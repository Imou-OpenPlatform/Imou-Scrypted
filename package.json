{
   "name": "scrypted-imou-camera",
   "scripts": {
      "scrypted-setup-project": "scrypted-setup-project",
      "prescrypted-setup-project": "scrypted-package-json",
      "build": "scrypted-webpack",
      "prepublishOnly": "WEBPACK_DEVTOOL=nosources-source-map NODE_ENV=production scrypted-webpack",
      "prescrypted-vscode-launch": "WEBPACK_DEVTOOL=nosources-source-map scrypted-webpack",
      "scrypted-vscode-launch": "scrypted-deploy-debug",
      "scrypted-deploy-debug": "scrypted-deploy-debug",
      "scrypted-debug": "scrypted-debug",
      "prescrypted-deploy": "WEBPACK_DEVTOOL=nosources-source-map scrypted-webpack",
      "scrypted-deploy": "scrypted-deploy",
      "scrypted-package-json": "scrypted-package-json",
      "scrypted-readme": "scrypted-readme"
   },
   "keywords": [
      "scrypted",
      "scrypted-plugin",
      "plugin",
      "imou",
      "lechange",
      "camera"
   ],
   "scrypted": {
      "name": "Imou Camera",
      "type": "DeviceProvider",
      "interfaces": [
         "DeviceProvider",
         "Settings"
      ]
   },
   "devDependencies": {
      "@scrypted/sdk": "^0.3.102",
      "@types/node": "^22.10.2"
   },
   "version": "0.0.1",
   "description": "Imou Open Platform cameras for Scrypted — discovery and cloud RTSP live preview",
   "license": "MIT"
}
