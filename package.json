{
   "name": "@imou/scrypted-imou-camera",
   "scripts": {
      "scrypted-setup-project": "scrypted-setup-project",
      "prescrypted-setup-project": "scrypted-package-json",
      "build": "scrypted-webpack",
      "prepublishOnly": "scrypted-changelog && WEBPACK_DEVTOOL=nosources-source-map NODE_ENV=production scrypted-webpack",
      "prescrypted-vscode-launch": "WEBPACK_DEVTOOL=nosources-source-map scrypted-webpack",
      "scrypted-vscode-launch": "scrypted-deploy-debug",
      "scrypted-deploy-debug": "scrypted-deploy-debug",
      "scrypted-debug": "scrypted-debug",
      "prescrypted-deploy": "WEBPACK_DEVTOOL=nosources-source-map scrypted-webpack",
      "scrypted-deploy": "scrypted-deploy",
      "scrypted-changelog": "scrypted-changelog",
      "scrypted-package-json": "scrypted-package-json",
      "scrypted-readme": "scrypted-readme",
      "probe:22": "node scripts/probe-22.mjs",
      "probe:22:hls": "node scripts/probe-22.mjs --hls",
      "probe:auth": "node scripts/probe-auth.mjs",
      "probe:vlc": "node scripts/probe-vlc-check.mjs",
      "probe:22:url": "node scripts/probe-stream.mjs",
      "probe:22:rtsp": "node scripts/probe-rtsp-metrics.mjs",
      "probe:22:hls-only": "node scripts/probe-hls.mjs"
   },
   "keywords": [
      "scrypted",
      "plugin",
      "imou",
      "camera"
   ],
   "scrypted": {
      "name": "Imou Camera",
      "type": "DeviceProvider",
      "interfaces": [
         "DeviceProvider",
         "Settings"
      ]
   },
   "devDependencies": {
      "@scrypted/sdk": "^0.3.102",
      "@types/node": "^22.10.2",
      "chalk": "^4.1.2"
   },
   "version": "0.0.1",
   "description": "Imou cloud camera plugin for Scrypted (phase 1: cloud preview)",
   "license": "MIT"
}
